<UserControl x:Class="FluxRoute.Views.Tabs.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="760">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхний блок фильтров -->
        <Border Grid.Row="0" Background="#111520" BorderBrush="#1E2235"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#4D6BFE" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Консоль FluxRoute" Foreground="#DCE4F0" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="?" Style="{StaticResource ActionBtnAccent}" Width="22" Height="22" Padding="0" FontSize="11"
                            Tag="Logs" Click="TabHelpButton_Click" Margin="8,0,0,0"
                            ToolTip="Как пользоваться логами?"
                            AutomationProperties.Name="Справка по логам" />
                </StackPanel>
                <TextBlock Text="События приложения, оркестратора, ИИ, TG Proxy, обновлений и сервиса."
                           Foreground="#5D6B82" FontSize="10" TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Компонент:" Foreground="#66758E"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                    <ComboBox Width="150" Height="28" Margin="0,0,12,6"
                              ItemsSource="{Binding LogCategoryFilters}"
                              SelectedItem="{Binding SelectedLogCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="Background" Value="#0D1422" />
                                <Setter Property="Foreground" Value="#C8D4EC" />
                                <Setter Property="BorderBrush" Value="#253553" />
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Text="Поиск:" Foreground="#66758E"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                    <TextBox Width="180" Height="28" Margin="0,0,12,6"
                             VerticalContentAlignment="Center"
                             Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="#0D1422" />
                                <Setter Property="Foreground" Value="#C8D4EC" />
                                <Setter Property="BorderBrush" Value="#253553" />
                                <Setter Property="CaretBrush" Value="#4D6BFE" />
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <CheckBox Content="Только ошибки" Foreground="#9BB0D0"
                              Margin="0,4,12,6" VerticalAlignment="Center"
                              IsChecked="{Binding LogsErrorsOnly, Mode=TwoWay}" />
                    <CheckBox Content="Автопрокрутка" Foreground="#9BB0D0"
                              Margin="0,4,12,6" VerticalAlignment="Center"
                              IsChecked="{Binding LogsAutoScroll, Mode=TwoWay}" />
                    <Button Style="{StaticResource ActionBtn}" Height="28"
                            Padding="10,0" Margin="0,0,6,6"
                            Command="{Binding CopyUnifiedLogsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" />
                            <TextBlock Text="Копировать" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}" Height="28"
                            Padding="10,0" Margin="0,0,6,6"
                            Command="{Binding SaveUnifiedLogsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" />
                            <TextBlock Text="Сохранить" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}" Height="28"
                            Padding="10,0" Margin="0,0,6,6"
                            Command="{Binding ClearUnifiedLogsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" />
                            <TextBlock Text="Очистить" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Блок текста логов с автоскроллом -->
        <Border Grid.Row="1" Background="#080B12" BorderBrush="#1E2235"
                BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="UnifiedLogsTextBox"
                     Background="Transparent" Foreground="#9BB0D0"
                     BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Padding="10,8"
                     IsReadOnly="True" IsUndoEnabled="False"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Text="{Binding UnifiedLogsText, Mode=OneWay}"
                     TextChanged="UnifiedLogsTextBox_TextChanged" />
        </Border>
    </Grid>
</UserControl>
