<UserControl x:Class="FluxRoute.Views.Tabs.HostlistsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="#4D6BFE" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Хостлисты" Foreground="#DCE4F0" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Редактирование списков доменов для стратегий защиты"
                       Foreground="#66758E" FontSize="10" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Список файлов слева -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0A0E18"
                BorderBrush="#1C2940" BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="FileListBox" ItemsSource="{Binding Files}"
                     SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#8997AD" />
                        <Setter Property="FontSize" Value="11.5" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#111A2B" />
                                            <Setter Property="Foreground" Value="#DCE4F0" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0E1522" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding DisplayTooltip}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Редактор справа -->
        <Border Grid.Row="1" Grid.Column="2" Background="#080B12"
                BorderBrush="#1E2235" BorderThickness="1" CornerRadius="8">
            <Grid>
                <TextBox Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="#9BB0D0"
                         BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="12,10"
                         IsReadOnly="{Binding IsEditing, Converter={StaticResource InvBool}}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsUndoEnabled="True" />
            </Grid>
        </Border>

        <!-- Панель действий снизу -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
                Background="#111520" BorderBrush="#1E2235"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#66758E"
                           FontSize="10.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE74E; Сохранить" Style="{StaticResource ActionBtnAccent}"
                            Height="30" Padding="10,0" Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding HasChanges}" />
                    <Button Content="&#xE711; Отменить" Style="{StaticResource ActionBtn}"
                            Height="30" Padding="10,0" Margin="0,0,8,0"
                            Command="{Binding CancelEditCommand}"
                            IsEnabled="{Binding HasChanges}" />
                    <Button Content="&#xE72C; Восстановить из бэкапа" Style="{StaticResource ActionBtn}"
                            Height="30" Padding="10,0"
                            Command="{Binding RestoreFromBackupCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
