<UserControl x:Class="FluxRoute.Views.Tabs.OrchestratorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="460" d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource SecH}" Text="УПРАВЛЕНИЕ" Margin="0" VerticalAlignment="Center" />
                <Button Content="?" Style="{StaticResource ActionBtnAccent}" Width="24" Height="24" Padding="0" FontSize="12"
                        Tag="Orchestrator" Click="TabHelpButton_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Как работает оркестратор?"
                        AutomationProperties.Name="Справка по оркестратору" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Margin="0,0,10,0" Command="{Binding ToggleOrchestratorCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                            <Setter Property="Content" Value="▶ Включить оркестратор" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrchestratorEnabled}" Value="True">
                                    <Setter Property="Content" Value="⏹ Отключить оркестратор" />
                                    <Setter Property="BorderBrush" Value="#6B1A1A" />
                                    <Setter Property="Foreground" Value="#E74C3C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Проверить сейчас" Style="{StaticResource ActionBtn}"
                        Command="{Binding CheckNowCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource Lbl}" Text="Интервал (мин): " Margin="0,0,8,0" />
                <TextBox Text="{Binding OrchestratorInterval, UpdateSourceTrigger=PropertyChanged}"
                         Width="50" Height="28" VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Lbl}" Text="Режим: " Margin="0,0,4,0" />
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Val}">
                            <Setter Property="Text" Value="ручной" />
                            <Setter Property="Foreground" Value="#4A5170" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrchestratorEnabled}" Value="True">
                                    <Setter Property="Text" Value="автоматический" />
                                    <Setter Property="Foreground" Value="#00D68F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Lbl}" Text="Следующая проверка: " Margin="0,0,4,0" />
                <TextBlock Style="{StaticResource Val}" Text="{Binding OrchestratorNextCheck}" />
            </StackPanel>

            <CheckBox Content="Синхронизировать домены с интерфейсом (list-general-user.txt)"
                IsChecked="{Binding SyncDomainsWithUI}" Margin="0,10,0,0" />

            <Rectangle Style="{StaticResource Sep}" />

            <TextBlock Style="{StaticResource SecH}" Text="САЙТЫ ДЛЯ ПРОВЕРКИ" />
            <WrapPanel Margin="0,0,0,8">
                <CheckBox Content="YouTube" IsChecked="{Binding SiteYouTube}" Margin="0,4,16,4" />
                <CheckBox Content="Discord" IsChecked="{Binding SiteDiscord}" Margin="0,4,16,4" />
                <CheckBox Content="Google" IsChecked="{Binding SiteGoogle}" Margin="0,4,16,4" />
                <CheckBox Content="Twitch" IsChecked="{Binding SiteTwitch}" Margin="0,4,16,4" />
                <CheckBox Content="Instagram" IsChecked="{Binding SiteInstagram}" Margin="0,4,16,4" />
                <CheckBox Content="Telegram" IsChecked="{Binding SiteTelegram}" Margin="0,4,16,4" />
                <CheckBox Content="TikTok" IsChecked="{Binding SiteTikTok}" Margin="0,4,16,4" />
            </WrapPanel>

            <Rectangle Style="{StaticResource Sep}" />
            <TextBlock Style="{StaticResource SecH}" Text="РЕЙТИНГ СТРАТЕГИЙ" />
            <Border Background="#211B05" BorderBrush="#6B541A" BorderThickness="1" CornerRadius="8"
                    Padding="10,8" Margin="0,0,0,10"
                    Visibility="{Binding NeedsInitialProfileScan, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="⚠️ Первичная проверка стратегий ещё не выполнена"
                               Foreground="#F0B429" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="При первом запуске оркестратора FluxRoute автоматически проверит все стратегии. После этого повторная проверка при запуске не потребуется."
                               Foreground="#B9A66A" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Margin="0,0,10,0"
                        Command="{Binding ScanProfilesCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionBtnAccent}">
                            <Setter Property="Content" Value="Сканировать все стратегии" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Content" Value="Сканирование..." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Посмотреть результат" Style="{StaticResource ActionBtn}"
                        Margin="0,0,8,0"
                        IsEnabled="{Binding CanViewScanResult}"
                        Command="{Binding ViewScanResultCommand}"
                        ToolTip="Открыть последнее сохранённое сканирование" />
                <!-- ═══ v1.6.0: Feature #53 — Кнопка сброса рейтинга ═══ -->
                <Button Content="🔄 Сбросить рейтинг" Style="{StaticResource RedBtn}"
                        Padding="12,5" FontSize="12"
                        Command="{Binding ResetProfileRatingsCommand}"
                        ToolTip="Очистить историю оценок оркестратора и ИИ" />
                <!-- ═══ v1.7.1: Отдельное действие очистки слабых эволюций (issue #89) ═══ -->
                <Button Content="🗑 Очистить слабые эволюции" Style="{StaticResource RedBtn}"
                        Padding="12,5" FontSize="12"
                        Command="{Binding CleanWeakEvolutionsCommand}"
                        ToolTip="Удалить эволюционированные стратегии с результатом ниже порога (только в режиме ИИ)" />
            </StackPanel>
</StackPanel>
    </ScrollViewer>
</UserControl>