<UserControl x:Class="FluxRoute.Views.Tabs.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="clr-namespace:FluxRoute.Views.Tabs">
    <UserControl.Resources>
        <Style x:Key="ModsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#71717A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10,14,9" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverBackground"
                                    Background="Transparent"
                                    CornerRadius="6,6,0,0">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveLine"
                                    Height="2"
                                    Background="#DCE4F0"
                                    VerticalAlignment="Bottom"
                                    Margin="10,0"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBackground" Property="Background" Value="#0DFFFFFF" />
                                <Setter Property="Foreground" Value="#B7C3D8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#DCE4F0" />
                                <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="#1E2235"
                                    BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Модификации"
                                               Foreground="#DCE4F0"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                    <Button DockPanel.Dock="Right" Content="?" Style="{StaticResource ActionBtnAccent}" Width="24" Height="24" Padding="0" FontSize="12"
                                            Tag="Mods" Click="TabHelpButton_Click" Margin="0,0,10,0"
                                            ToolTip="Как работают модификации?"
                                            AutomationProperties.Name="Справка по модификациям" />
                                    <Border Width="1" Height="18"
                                            Background="#30363D"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                    <TabPanel IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent" />
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Background="Transparent" Padding="0,12,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <TabControl Style="{StaticResource ModsTabControl}"
                    ItemContainerStyle="{StaticResource ModsTabItem}"
                    SelectedIndex="0">
            <!-- Штатные стратегии из engine/ — текущая логика без изменений. -->
            <TabItem Header="Встроенные">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#4D6BFE" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Модификации" Foreground="#DCE4F0" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Список стратегий из engine/. Нажмите «Редактировать» для изменения .bat-файла."
                                   Foreground="#66758E" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#1C2940"
                            BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1422" BorderBrush="#1C2940"
                                                BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                        Background="#111520" BorderBrush="#253553" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="15" Foreground="#4D6BFE"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#DCE4F0"
                                                               FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FileName}" Foreground="#55647D"
                                                               FontSize="9.5" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource ActionBtn}"
                                                            Height="28" Padding="10,0" Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.EditStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="12" Foreground="#4D90E2" Margin="0,0,6,0" />
                                                            <TextBlock Text="Редактировать" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Content="Удалить копию"
                                                            Style="{StaticResource ActionBtnRed}"
                                                            Height="28" Padding="10,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsUserCopy, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Содержимое этой вкладки придёт из feature/mods-csharp после слияния. -->
                        <TabItem Header="Пользовательские">
                <tabs:UserModsPage DataContext="{Binding ModsViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>