<UserControl x:Class="FluxRoute.Views.Tabs.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="760"
             Loaded="ModsPage_Loaded"
             Background="#0C0F17">
    <Grid>
        <!-- ═══════════ HEADER ═══════════ -->
        <Border x:Name="HeaderBorder"
                Background="#0C0F17"
                BorderBrush="#21262D" BorderThickness="0,0,0,1"
                Padding="24,20,24,14"
                VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Моды" FontSize="15" FontWeight="SemiBold"
                               Foreground="#C9D1D9" />
                    <TextBlock Text="Пользовательские модификации — скрипты и конфиги"
                               FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ GitHub" Style="{StaticResource ActionBtnAccent}"
                            Height="28" FontSize="11" Padding="10,4"
                            Margin="0,0,8,0"
                            ToolTip="Синхронизировать моды из GitHub-репозитория"
                            Command="{Binding SyncFromGithubCommand}" />
                    <Button Content="Создать" Style="{StaticResource ActionBtn}"
                            Height="28" FontSize="11" Padding="10,4"
                            Margin="0,0,8,0"
                            Command="{Binding CreateModCommand}" />
                    <Button Content="Импорт" Style="{StaticResource ActionBtn}"
                            Height="28" FontSize="11" Padding="10,4"
                            Command="{Binding ImportModCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Margin="0,70,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,24">

                <!-- Статус-бар (видимая реакция на команды) -->
                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="#8B949E" TextWrapping="Wrap" />
                </Border>

                <!-- Пустое состояние -->
                <Border x:Name="EmptyState"
                        Height="120" CornerRadius="12"
                        BorderBrush="#21262D" BorderThickness="1"
                        Background="#0D1117"
                        Visibility="{Binding HasMods, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Моды не найдены"
                                   FontSize="13" Foreground="#8B949E"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Поместите папки с manifest.json в mods/ или создайте новый мод"
                                   FontSize="11" Foreground="#6E7681"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Button Content="Создать мод" Style="{StaticResource ActionBtnAccent}"
                                Height="28" FontSize="11" Padding="12,4"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding CreateModCommand}" />
                    </StackPanel>
                </Border>

                <!-- Список модов -->
                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161B22"
                                    BorderBrush="#21262D" BorderThickness="1"
                                    CornerRadius="12" Padding="12"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="⋮⋮" FontSize="16"
                                               Foreground="#484F58"
                                               VerticalAlignment="Top"
                                               Margin="0,2,6,0"
                                               Cursor="Hand" />

                                    <Border Grid.Column="1"
                                            Width="44" Height="44"
                                            CornerRadius="10"
                                            BorderBrush="#30363D" BorderThickness="1"
                                            Background="#21262D"
                                            VerticalAlignment="Top" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#8B949E"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#C9D1D9"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Version, StringFormat=' v{0}'}"
                                                       FontSize="10" Foreground="#8B949E"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>

                                        <TextBlock FontSize="11" Foreground="#8B949E" Margin="0,1,0,0">
                                            <Run Text="от @"/>
                                            <Run Text="{Binding Author, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Foreground="#6E7681"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />

                                        <ItemsControl ItemsSource="{Binding Dependencies}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1C2128"
                                                            CornerRadius="10"
                                                            Padding="6,2" Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   Foreground="#8B949E" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Top"
                                                Margin="10,0,0,0" MinWidth="100">
                                        <CheckBox Style="{StaticResource IosToggle}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <Button Content="Изменить"
                                                    Style="{StaticResource ActionBtn}"
                                                    Height="24" FontSize="10" Padding="6,2"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Экспорт"
                                                    Style="{StaticResource ActionBtn}"
                                                    Height="24" FontSize="10" Padding="6,2"
                                                    Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ExportModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Удалить"
                                                    Style="{StaticResource ActionBtnRed}"
                                                    Height="24" FontSize="10" Padding="6,2"
                                                    Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
