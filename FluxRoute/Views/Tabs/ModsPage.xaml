<UserControl x:Class="FluxRoute.Views.Tabs.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="#4D6BFE" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Модификации" Foreground="#DCE4F0" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Список стратегий из engine/. Нажмите «Редактировать» для изменения .bat-файла."
                       Foreground="#66758E" FontSize="10" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Список стратегий -->
        <Border Grid.Row="1" Background="#0A0E18" BorderBrush="#1C2940"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D1422" BorderBrush="#1C2940"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#111520" BorderBrush="#253553" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="#4D6BFE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Инфо -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#DCE4F0"
                                                   FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FileName}" Foreground="#55647D"
                                                   FontSize="9.5" />
                                    </StackPanel>

                                    <!-- Кнопка Редактировать -->
                                    <Button Grid.Column="2" Style="{StaticResource ActionBtn}"
                                            Height="28" Padding="10,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.EditStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="#4D6BFE" Margin="0,0,6,0" />
                                            <TextBlock Text="Редактировать" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
