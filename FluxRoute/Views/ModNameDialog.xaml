<Window x:Class="FluxRoute.Views.ModNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание мода"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0C0F17" BorderBrush="#1C1F2E" BorderThickness="1" CornerRadius="12"
            MinWidth="360" MaxWidth="440"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel Margin="24,20">
            <TextBlock Text="Новый мод"
                       FontFamily="Segoe UI" Foreground="#C8D4EC" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Введите название мода. Папка создастся в mods/ автоматически."
                       FontFamily="Segoe UI" Foreground="#7E89A8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox x:Name="NameBox"
                     FontFamily="Segoe UI" FontSize="13"
                     Foreground="#E6EDF3" Background="#11141E"
                     BorderBrush="#30363D" BorderThickness="1"
                     Padding="10,7" Margin="0,0,0,16"
                     KeyDown="NameBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="Cancel_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0,0,10,0"/>
                <Button Content="Создать" Click="Confirm_Click"
                        Style="{StaticResource AccentConfirmBtn}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
