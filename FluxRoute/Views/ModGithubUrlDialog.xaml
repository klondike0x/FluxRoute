<Window x:Class="FluxRoute.Views.ModGithubUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Синхронизация из GitHub"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0C0F17" BorderBrush="#1C1F2E" BorderThickness="1" CornerRadius="12"
            MinWidth="380" MaxWidth="460"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel Margin="24,20">
            <TextBlock Text="Синхронизация из GitHub"
                       FontFamily="Segoe UI" Foreground="#C8D4EC" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Введите ссылку на репозиторий с модами. Приложение скачает его, найдёт все моды и установит недостающие автоматически."
                       FontFamily="Segoe UI" Foreground="#7E89A8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox x:Name="UrlBox"
                     FontFamily="Segoe UI" FontSize="13"
                     Foreground="#E6EDF3" Background="#11141E"
                     BorderBrush="#30363D" BorderThickness="1"
                     Padding="10,7" Margin="0,0,0,16"
                     Text=""
                     ToolTip="Например: https://github.com/owner/repository"
                     KeyDown="UrlBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="Cancel_Click"
                        Style="{StaticResource DialogCancelBtn}" />
                <Button Content="Синхронизировать" Click="Confirm_Click"
                        Style="{StaticResource AccentConfirmBtn}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
