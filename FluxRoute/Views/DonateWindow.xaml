<Window x:Class="FluxRoute.Views.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поддержать автора"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#0C0F17" BorderBrush="#1C1F2E" BorderThickness="1" CornerRadius="12"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="♥" FontSize="16" Foreground="#F85149" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Поддержать автора" FontFamily="Segoe UI" FontSize="16"
                           FontWeight="SemiBold" Foreground="#C8D4EC" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="13"
                       Foreground="#7E89A8" LineHeight="20" Margin="0,0,0,18">
                FluxRoute делается одним разработчиком в свободное время.
                Если проект помог тебе, любая поддержка мотивирует продолжать развитие.
            </TextBlock>

            <Border Background="#1A1E2B" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8"
                    Height="44" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="Ton_Click">
                <Grid Margin="14,0">
                    <TextBlock Text="Донат через TON" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#58A6FF" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="#1A1E2B" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8"
                    Height="44" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="Bitcoin_Click">
                <Grid Margin="14,0">
                    <TextBlock Text="Донат через Bitcoin" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#F2A900" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="#1A1E2B" BorderBrush="#252A38" BorderThickness="1" CornerRadius="8"
                    Height="44" Cursor="Hand" MouseLeftButtonDown="GitHub_Click">
                <Grid Margin="14,0">
                    <TextBlock Text="Поставить звёзду на GitHub" FontFamily="Segoe UI" FontSize="13"
                               Foreground="#8B949E" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="Спасибо, что ты с проектом!" FontFamily="Segoe UI"
                       FontSize="11" Foreground="#484F5E" TextAlignment="Center" Margin="0,16,0,8"/>
            <Button Content="Закрыть" Style="{StaticResource ActionBtn}" Width="88" Height="32" HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Border>
</Window>
