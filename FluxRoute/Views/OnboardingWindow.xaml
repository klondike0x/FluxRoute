<Window x:Class="FluxRoute.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в FluxRoute"
        Width="520" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#0C0F17" CornerRadius="14" BorderBrush="#1E2840" BorderThickness="1">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="#4D6BFE" HorizontalAlignment="Center" />
                <TextBlock Text="Добро пожаловать в FluxRoute" Foreground="#DCE4F0"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="Настроим всё для оптимальной работы" Foreground="#66758E"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Вопросы -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <!-- 1. Выбор компонента -->
                <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Выберите компонент" Foreground="#DCE4F0"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding ComponentOptions}"
                                  SelectedIndex="{Binding SelectedComponentIndex, Mode=TwoWay}"
                                  Height="32" Margin="0,0,0,4">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Background" Value="#111827" />
                                    <Setter Property="Foreground" Value="#DCE4F0" />
                                    <Setter Property="BorderBrush" Value="#3B4A65" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock Foreground="#55647D" FontSize="9.5"
                                   Text="Zapret классический (WinDivert) или Zapret 2 (Flowseal)" />
                    </StackPanel>
                </Border>

                <!-- 2. Выбор стратегии -->
                <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. Выберите стратегию" Foreground="#DCE4F0"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ComboBox x:Name="StrategyCombo"
                                  ItemsSource="{Binding AvailableStrategies}"
                                  SelectedValue="{Binding SelectedStrategyFileName, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="FileName"
                                  Height="32" Margin="0,0,0,4">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Background" Value="#111827" />
                                    <Setter Property="Foreground" Value="#DCE4F0" />
                                    <Setter Property="BorderBrush" Value="#3B4A65" />
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock Foreground="#55647D" FontSize="9.5"
                                   Text="Стратегия, с которой начнётся проверка доступности сайтов" />
                    </StackPanel>
                </Border>

                <!-- 3. Подсказка про проверку -->
                <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="3. Автопроверка доступа" Foreground="#DCE4F0"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Foreground="#55647D" FontSize="10" TextWrapping="Wrap">
                            После завершения настройки FluxRoute автоматически проверит доступность YouTube и Discord через выбранную стратегию.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Кнопка завершения -->
            <Button Grid.Row="2" Height="40" Margin="0,20,0,0"
                    Command="{Binding CompleteCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#4D6BFE" CornerRadius="10">
                            <TextBlock Text="Настроить и продолжить" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D5BEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
