<Window x:Class="FluxRoute.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в FluxRoute"
        Width="520" Height="560"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- Локальный стиль ComboBox — в изолированном Window нет глобального стиля -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#DCE4F0" />
            <Setter Property="BorderBrush" Value="#3B4A65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border Background="#0C0F17" CornerRadius="14" BorderBrush="#1E2840" BorderThickness="1">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                           Foreground="#4D6BFE" HorizontalAlignment="Center" />
                <TextBlock Text="Добро пожаловать в FluxRoute" Foreground="#DCE4F0"
                           FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Text="Настроим всё для оптимальной работы" Foreground="#66758E"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Шаги со скроллом -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <!-- 1. Выбор компонента -->
                    <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. Выберите компонент" Foreground="#DCE4F0"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding ComponentOptions}"
                                      SelectedIndex="{Binding SelectedComponentIndex, Mode=TwoWay}"
                                      Height="32" />
                            <TextBlock Foreground="#55647D" FontSize="9.5" Margin="0,4,0,0"
                                       Text="Zapret классический (WinDivert) или Zapret 2 (Flowseal)" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Выбор стратегии -->
                    <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="2. Выберите стратегию" Foreground="#DCE4F0"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding AvailableStrategies}"
                                      SelectedValue="{Binding SelectedStrategyFileName, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="FileName"
                                      Height="32" />
                            <TextBlock Foreground="#55647D" FontSize="9.5" Margin="0,4,0,0"
                                       Text="Стратегия, с которой начнётся проверка доступности сайтов" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Автопроверка доступа (после выбора стратегии) -->
                    <Border Background="#0A0E18" BorderBrush="#1C2940" BorderThickness="1"
                            CornerRadius="10" Padding="14,12"
                            Visibility="{Binding IsStep3Visible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="3. Автопроверка доступа" Foreground="#DCE4F0"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Foreground="#55647D" FontSize="10" TextWrapping="Wrap">
                                После завершения настройки FluxRoute автоматически проверит доступность YouTube и Discord через выбранную стратегию.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопка завершения -->
            <Button Grid.Row="2" Height="42" Margin="0,14,0,0"
                    Command="{Binding CompleteCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#4D6BFE" CornerRadius="10">
                            <TextBlock Text="Настроить и продолжить" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D5BEE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#2A3050" />
                                <Setter Property="Foreground" Value="#66758E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
