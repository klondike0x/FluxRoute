<Window x:Class="FluxRoute.Views.ModEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение мода"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ModFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7E89A8" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0C0F17" BorderBrush="#1C1F2E" BorderThickness="1" CornerRadius="12"
            Width="460" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel Margin="24,20">
            <TextBlock Text="Изменить мод"
                       FontFamily="Segoe UI" Foreground="#C8D4EC" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Text="Изменения сохранятся в manifest.json выбранной модификации."
                       FontFamily="Segoe UI" Foreground="#7E89A8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Название" Style="{StaticResource ModFieldLabel}" />
            <TextBox x:Name="NameBox" Margin="0,4,0,10"
                     FontFamily="Segoe UI" FontSize="13"
                     Foreground="#E6EDF3" Background="#11141E"
                     BorderBrush="#30363D" BorderThickness="1" Padding="10,7" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Версия" Style="{StaticResource ModFieldLabel}" />
                    <TextBox x:Name="VersionBox" Margin="0,4,0,0"
                             FontFamily="Segoe UI" FontSize="13"
                             Foreground="#E6EDF3" Background="#11141E"
                             BorderBrush="#30363D" BorderThickness="1" Padding="10,7" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Автор" Style="{StaticResource ModFieldLabel}" />
                    <TextBox x:Name="AuthorBox" Margin="0,4,0,0"
                             FontFamily="Segoe UI" FontSize="13"
                             Foreground="#E6EDF3" Background="#11141E"
                             BorderBrush="#30363D" BorderThickness="1" Padding="10,7" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Описание" Style="{StaticResource ModFieldLabel}" />
            <TextBox x:Name="DescriptionBox" Height="74" Margin="0,4,0,4"
                     FontFamily="Segoe UI" FontSize="13"
                     Foreground="#E6EDF3" Background="#11141E"
                     BorderBrush="#30363D" BorderThickness="1" Padding="10,7"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="ErrorText" Text="Введите название мода."
                       Visibility="Collapsed" Foreground="#F85149" FontSize="11" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Отмена" Click="Cancel_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0,0,10,0" />
                <Button Content="Сохранить" Click="Confirm_Click"
                        Style="{StaticResource AccentConfirmBtn}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
