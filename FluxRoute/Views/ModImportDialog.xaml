<Window x:Class="FluxRoute.Views.ModImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт модификации"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0C0F17" BorderBrush="#1C1F2E" BorderThickness="1" CornerRadius="12"
            MinWidth="380" MaxWidth="420"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel Margin="24,20">
            <TextBlock Text="Импорт модификации"
                       FontFamily="Segoe UI" Foreground="#C8D4EC" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Импортируйте папку, ZIP-архив, файлы или GitHub-репозиторий."
                       FontFamily="Segoe UI" Foreground="#7E89A8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- 2×2 сетка источников: глифы Segoe MDL2 Assets (гарантированно отображаются) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Click="Folder_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0"
                        Height="52" FontSize="12">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#4A90E2" HorizontalAlignment="Center" />
                        <TextBlock Text="Папка" FontWeight="SemiBold" Foreground="#C8D4EC"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Click="Zip_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0"
                        Height="52" FontSize="12">
                    <StackPanel>
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#4A90E2" HorizontalAlignment="Center" />
                        <TextBlock Text="ZIP-архив" FontWeight="SemiBold" Foreground="#C8D4EC"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" Click="Files_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0"
                        Height="52" FontSize="12">
                    <StackPanel>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#4A90E2" HorizontalAlignment="Center" />
                        <TextBlock Text="Файлы" FontWeight="SemiBold" Foreground="#C8D4EC"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" Click="Github_Click"
                        Style="{StaticResource DialogCancelBtn}" Margin="0"
                        Height="52" FontSize="12">
                    <StackPanel>
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#4A90E2" HorizontalAlignment="Center" />
                        <TextBlock Text="GitHub" FontWeight="SemiBold" Foreground="#C8D4EC"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- GitHub URL (показывается при выборе GitHub) -->
            <StackPanel x:Name="GithubPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="Ссылка на репозиторий:" FontFamily="Segoe UI"
                           Foreground="#7E89A8" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="GithubUrlBox"
                         FontFamily="Segoe UI" FontSize="12"
                         Foreground="#E6EDF3" Background="#11141E"
                         BorderBrush="#30363D" BorderThickness="1"
                         Padding="10,7"
                         KeyDown="GithubUrlBox_KeyDown" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Импортировать" Click="GithubConfirm_Click"
                            Style="{StaticResource AccentConfirmBtn}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DefaultButtons" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Click="Cancel_Click"
                        Style="{StaticResource DialogCancelBtn}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
