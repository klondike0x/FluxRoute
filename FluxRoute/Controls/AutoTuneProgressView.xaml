<UserControl x:Class="FluxRoute.Controls.AutoTuneProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Прогресс -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AutoTuneResultVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#8B949E"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Приложение проверит все комбинации IPSet mode и Gaming mode для текущей стратегии." />
            <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#C9D1D9"
                       Text="{Binding AutoTuneStatusText}" Margin="0,0,0,8" />
            <ProgressBar Value="{Binding AutoTuneProgress}"
                         Minimum="0" Maximum="100" Height="6"
                         Background="#21262D" Foreground="#58A6FF"
                         BorderThickness="0" Margin="0,0,0,4" />
            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#8B949E"
                       Margin="0,0,0,12"
                       Text="{Binding AutoTuneProgress, StringFormat={}{0:0}%}" />
            <TextBlock FontFamily="Segoe UI" FontSize="9" Foreground="#66758E"
                       Text="ТЕКУЩИЙ РЕЙТИНГ" Margin="0,8,0,7" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0D1A16" BorderBrush="#234B38"
                        BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="ЛУЧШИЕ КОМБИНАЦИИ" FontFamily="Segoe UI"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#3FB950" />
                        <TextBlock Text="{Binding AutoTuneBestSummary}" FontFamily="Consolas"
                                   FontSize="10" Foreground="#B8E6C0" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1B1215" BorderBrush="#4B2930"
                        BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ХУДШИЕ КОМБИНАЦИИ" FontFamily="Segoe UI"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#F85149" />
                        <TextBlock Text="{Binding AutoTuneWorstSummary}" FontFamily="Consolas"
                                   FontSize="10" Foreground="#F0B8B8" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        <!-- Результат -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AutoTuneResultVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#3FB950"
                       FontWeight="SemiBold" Text="Лучшая комбинация найдена."
                       Margin="0,0,0,12" />
            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,4">
                <Run Text="IPSet mode: " />
                <Run Text="{Binding BestIpSet}" Foreground="#58A6FF" />
            </TextBlock>
            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,4">
                <Run Text="Gaming mode: " />
                <Run Text="{Binding BestProtocol}" Foreground="#58A6FF" />
            </TextBlock>
            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,4">
                <Run Text="Успешно: " />
                <Run Text="{Binding BestSuccessCount}" Foreground="#3FB950" />
                <Run Text="/" />
                <Run Text="{Binding BestTotalCount}" />
            </TextBlock>
            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,16">
                <Run Text="Время: " />
                <Run Text="{Binding AutoTuneElapsedSeconds, StringFormat={}{0:0.0}}" />
                <Run Text=" сек." />
            </TextBlock>
            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,16">
                <Run Text="Средняя задержка: " />
                <Run Text="{Binding BestLatencyMs, StringFormat={}{0:0}}" Foreground="#58A6FF" />
                <Run Text=" мс" />
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
